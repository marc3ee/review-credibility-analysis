{
    "manifest_version": 3,
    "name": "Simple Alert Extension",
    "version": "1.0",
    "description": "Shows an alert when clicked",
    "action": {
      "default_popup": "popup.html",
      "default_title": "Click me for alert"
    },
    "permissions": ["activeTab", "scripting"],
    "host_permissions": ["http://localhost:5000/*"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ]
  }